ro.product.ab_ota_partitions=boot,init_boot,vendor_boot,dtbo,system,system_dlkm,vendor,vendor_dlkm,odm,odm_dlkm,vbmeta,vbmeta_system,vbmeta_system_dlkm,vbmeta_vendor,vbmeta_vendor_dlkm,vbmeta_odm,vbmeta_odm_dlkm,recovery_vbmeta,modem,mcf_ota
