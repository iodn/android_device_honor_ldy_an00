android_test {
    name: "LdyAn00CameraCompatibilityTests",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "33",
    certificate: "testkey",
    static_libs: ["androidx.test.runner", "androidx.test.ext.junit"],
    test_suites: ["device-tests"],
}
