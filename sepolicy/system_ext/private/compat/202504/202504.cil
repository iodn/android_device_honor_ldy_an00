; Preserve the real stock public type identities required by retained vendor.
(typeattribute system_teecd_202504)
(expandtypeattribute (system_teecd_202504) true)
(typeattributeset system_teecd_202504 (system_teecd))
(typeattribute system_teecd_exec_202504)
(expandtypeattribute (system_teecd_exec_202504) true)
(typeattributeset system_teecd_exec_202504 (system_teecd_exec))

(typeattribute teecd_data_file_202504)
(expandtypeattribute (teecd_data_file_202504) true)
(typeattributeset teecd_data_file_202504 (teecd_data_file))

(typeattribute sysfs_tee_202504)
(expandtypeattribute (sysfs_tee_202504) true)
(typeattributeset sysfs_tee_202504 (sysfs_tee))

(typeattribute htee_version_prop_202504)
(expandtypeattribute (htee_version_prop_202504) true)
(typeattributeset htee_version_prop_202504 (htee_version_prop))

(typeattribute htee_basic_prop_202504)
(expandtypeattribute (htee_basic_prop_202504) true)
(typeattributeset htee_basic_prop_202504 (htee_basic_prop))

(typeattribute vtservice_202504)
(expandtypeattribute (vtservice_202504) true)
(typeattributeset vtservice_202504 (vtservice))

; Bind the exact retained vendor HAL only when both private vendor symbols exist.
; Platform-only compatibility tests intentionally have no vendor policy.
(optional honor_ldy_an00_retained_face_binding
  (typeattributeset hal_facerecognize_client (honor_ldy_an00_face_bridge_client))
  (typeattributeset honor_ldy_an00_face_bridge_server (hal_facerecognize_default))
)

; Keep power-table access scoped to the exact retained MediaTek and Honor HALs.
(optional honor_ldy_an00_power_config_binding
  (typeattributeset honor_ldy_an00_power_config_reader
    (mtk_hal_power hal_uniperf_aidl_default))
)

; Exact sysfs labels from the retained stock thermal/shell drivers.
(optional honor_ldy_an00_shell_temperature_binding
  (typeattributeset honor_ldy_an00_shell_sensor (sysfs_therm))
  (typeattributeset honor_ldy_an00_shell_output (sysfs_pg))
)

; Bind the framework bridge only to this retained vendor Binder client contract.
(optional honor_ldy_an00_apl_bridge_binding
  (typeattributeset hal_hndisplayengine_client (honor_ldy_an00_apl_bridge_client))
)

; Preserve only existing readers of the one retained kernel receipt node.
; Every member had the corresponding permission on its previous sysfs_leds label.
(optional honor_ldy_an00_apl_backlight_existing_readers_binding
  (typeattributeset honor_ldy_an00_apl_backlight_existing_reader
    (apexd init tee ueventd vendor_init vold hal_bluetooth_btlinux hal_bluetooth_default hal_graphics_composer_default hal_light_default hal_radio_config_default hal_radio_default hal_vibrator_default hal_wifi_default hal_wifi_supplicant_default rild wpa_supplicant_macsec factory gnss_daemon merged_hal_service meta_tst mnld mtk_hal_bluetooth mtk_hal_light mtk_hal_mmlpq mtk_hal_power mtk_hal_pq mtk_hal_wifi thermal_core hal_displayengine_default hal_hndisplayengine_default dvs_aidl_default hal_display_default hal_waudio_default))
  (typeattributeset honor_ldy_an00_apl_backlight_existing_stat
    (apexd init tee ueventd vendor_init vold hal_bluetooth_btlinux hal_bluetooth_default hal_graphics_composer_default hal_light_default hal_radio_config_default hal_radio_default hal_vibrator_default hal_wifi_default hal_wifi_supplicant_default rild wpa_supplicant_macsec factory gnss_daemon merged_hal_service meta_tst mnld mtk_hal_bluetooth mtk_hal_light mtk_hal_mmlpq mtk_hal_power mtk_hal_pq mtk_hal_wifi thermal_core hal_displayengine_default hal_hndisplayengine_default dvs_aidl_default hal_waudio_default))
)
